# Set default behavior to automatically normalize line endings
* text=auto

# Ensure all shell scripts and linux config files maintain LF line endings
*.sh text eol=lf
*.service text eol=lf
*.cfg text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pkl binary
*.zip binary
*.ico binary
